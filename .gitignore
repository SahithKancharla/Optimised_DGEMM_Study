# Compiled benchmark binaries (extension-less ELF executables on Linux/WSL,
# not caught by the *.exe/*.out patterns above). Every entry here has a
# same-named .c/.S source tracked right next to it -- rebuild with the
# matching build.sh/tune_blocking.sh rather than committing the binary.
baselines/bin/
avx2/sweep/bin/
avx2/tune_bin/
avx2/asm_kernel/tune_bin/
avx2/matmul_avx2_tuned
avx2/matmul_v2_swap
avx2/matmul_v3_unroll_prefetch
avx2/matmul_v4_retuned
avx2/matmul_v4_threading
avx2/matmul_v5_unroll4
avx2/matmul_v6_mr6
avx2/matmul_v6_retuned
avx2/matmul_v7_4x12
avx2/matmul_v7_retuned
avx2/asm_kernel/matmul_asm
avx2/asm_kernel/matmul_asm_v2_retuned
avx2/asm_kernel/matmul_asm_v2_vecpack
avx2/asm_kernel/matmul_asm_v3_transpack
avx2/asm_kernel/matmul_asm_v4_dynsched
avx2/asm_kernel/matmul_asm_v4_retuned
avx2/asm_kernel/matmul_asm_v5_cprefetch
avx2/asm_kernel/test_kernel_standalone
avx2/asm_kernel/v4_blis_params
avx2/portable/matmul_portable
accuracy/bench_accuracy
strassen2/bench_strassen
strassen2/test_strassen
roofline/stream_triad
topology/classify_cores
topology/classify_cores_native

# Auto-generated microkernel sweep sources -- regenerate with
# `python3 avx2/gen_kernels.py` (uses avx2/kernel_template.c.in); only the
# template and generator are hand-maintained.
avx2/sweep/kernel_*.c
avx2/sweep/manifest.csv

# Scratch outputs of tuning/diagnostic scripts -- regenerate by rerunning
# the corresponding .sh/.c (tune_blocking*.sh, classify_cores*). Final
# curated benchmark results referenced by FINDINGS.md/the paper are
# committed separately (as named result CSVs, not these scratch ones).
avx2/tune_results*.csv
avx2/best_blocking*.txt
avx2/asm_kernel/tune_results*.csv
avx2/asm_kernel/best_blocking*.txt
topology/core_classification.csv
topology/core_classification_native.csv

# Misc
/tmp/
